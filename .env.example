# Variables pour l'environnement de développement (localhost)
# URL de base de l'API Spring Boot (généralement http://localhost:8080/api)
VITE_API_BASE_URL=http://localhost:8080/api
# Cible utilisée par le proxy de dev Vite pour éviter les soucis de CORS
VITE_PROXY_TARGET=http://localhost:8080
# Flux caméra utilisé par l'iframe (optionnel)
VITE_CAMERA_TARGET=http://10.41.39.153

# Variables pour la production (décommentez et adaptez selon votre déploiement)
# VITE_API_BASE_URL=https://api.exemple.com/api
# VITE_PROXY_TARGET=https://api.exemple.com
# VITE_CAMERA_TARGET=http://10.41.39.153
